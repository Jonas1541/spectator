# =============================================================================
# Spectator - Binance API Credentials
# =============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file to version control.
#
# To get API keys: https://www.binance.com/en/my/settings/api-management
# For Futures Testnet: https://testnet.binancefuture.com/
# =============================================================================

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# =============================================================================
# Telegram Bot Notifications
# =============================================================================
# Create a bot via @BotFather on Telegram and get the token.
# Get your chat_id by messaging @userinfobot on Telegram.
# =============================================================================

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
